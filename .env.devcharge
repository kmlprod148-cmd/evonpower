# ==============================================
# Payments — defaults
# ==============================================
DEFAULT_PAYMENT_METHOD=stripe
PAYMENT_DEFAULT_CURRENCY=EUR
PAYMENT_VERIFY_SIGNATURES=true
PAYMENT_TIMEOUT=30
PAYMENT_MAX_RETRIES=3
PAYMENT_MIN_AMOUNT=0.50
PAYMENT_MAX_AMOUNT=10000
