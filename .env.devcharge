# ==============================================
# EVON — devcharge.evonpower.com
# Production environment file
# Rename to ".env" on the server (or symlink) before serving traffic.
# ==============================================

APP_NAME=EVON
APP_ENV=production
APP_KEY=base64:oRBMJwuyrgotVQ+TQAW6ywn30MQhz+b6fHZctDBfBoI=
APP_DEBUG=true
APP_URL=https://devcharge.evonpower.com
APP_INSTALLED=true
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
DEFAULT_CURRENCY=EUR

# ==============================================
# Logging
# ==============================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ==============================================
# Database — MySQL (production)
# Update credentials to match the devcharge MySQL user/database.
# ==============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evon_devcharge
DB_USERNAME=evon_devcharge
DB_PASSWORD=

# ==============================================
# Session / Cache / Queue
# ==============================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.evonpower.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ==============================================
# Mail
# ==============================================
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@evonpower.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# Setup Wizard — DISABLED on a deployed/installed site
# Re-enable temporarily and run `php artisan evon:setup-password` if needed.
# ==============================================
SETUP_ENABLED=false
SETUP_DEVELOPER_PASSWORD_HASH=
SETUP_DEVELOPER_PASSWORD=
SETUP_BROWSER_TOKEN_HASH=
SETUP_BROWSER_TOKEN=
SETUP_ALLOW_LOCAL_CLAIM=false

# ==============================================
# Infobip SMS Verification
# ==============================================
INFOBIP_API_KEY=2912d8db2018c171a5a8b1005197b3c3-05353237-7e9c-4440-a874-54a4a0624969
INFOBIP_BASE_URL=https://vlxne.api.infobip.com
INFOBIP_SENDER=EVON

# ==============================================
# Stripe Payment Gateway (Test Sandbox)
# ----------------------------------------------
# Three groups of variables exist because three configs read different names:
#   - config/stripe.php   -> STRIPE_PUBLISHABLE_KEY / STRIPE_SECRET_KEY
#   - config/services.php -> STRIPE_KEY / STRIPE_SECRET
#   - config/payments.php -> STRIPE_PUBLIC_KEY / STRIPE_SECRET_KEY
# Keep all three populated so every consumer resolves the same key.
# ==============================================

# --- config/stripe.php ---
STRIPE_PUBLISHABLE_KEY=pk_test_51TGds3PrQglLwFCbTdG1nsYvLFVPd2fFEd1KRAEabtBKeMmqFhjNUtbbCOwsqoMBCh1AkiRn9XyItOBXs0vGt7pC00NimPueuT
STRIPE_SECRET_KEY=sk_test_51TGds3PrQglLwFCbbwSLi2pzOdL3auHFJqiKCRyWs3nqqmpF9Fenqh88HSSNJXzq5APkLFimeIugfvNRTmsQhdaY0081nyoUop

# --- config/services.php ---
STRIPE_KEY=pk_test_51TGds3PrQglLwFCbTdG1nsYvLFVPd2fFEd1KRAEabtBKeMmqFhjNUtbbCOwsqoMBCh1AkiRn9XyItOBXs0vGt7pC00NimPueuT
STRIPE_SECRET=sk_test_51TGds3PrQglLwFCbbwSLi2pzOdL3auHFJqiKCRyWs3nqqmpF9Fenqh88HSSNJXzq5APkLFimeIugfvNRTmsQhdaY0081nyoUop

# --- config/payments.php ---
STRIPE_PUBLIC_KEY=pk_test_51TGds3PrQglLwFCbTdG1nsYvLFVPd2fFEd1KRAEabtBKeMmqFhjNUtbbCOwsqoMBCh1AkiRn9XyItOBXs0vGt7pC00NimPueuT

# --- Webhook — fill in after creating the endpoint:
#     https://devcharge.evonpower.com/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Stripe behavior ---
STRIPE_TEST_MODE=true
STRIPE_CURRENCY=eur
STRIPE_DEFAULT_CURRENCY=eur
STRIPE_API_VERSION=2023-10-16
STRIPE_VERIFY_SIGNATURES=true
STRIPE_LOG_REQUESTS=true
STRIPE_LOG_RESPONSES=true
STRIPE_LOG_WEBHOOKS=true

# ==============================================
# CMI Payment Gateway (Test Environment)
# Set CMI_STOREKEY from the CMI back office before going live.
# ==============================================
CMI_TEST_MODE=true
CMI_CLIENTID=600002823
CMI_STOREKEY=
CMI_PAYMENT_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_BASE_URL=https://testpayment.cmi.co.ma
CMI_STORETYPE=3D_PAY_HOSTING
CMI_DEFAULT_CURRENCY=MAD
CMI_DEFAULT_LANGUAGE=fr
CMI_LOG_REQUESTS=true
CMI_LOG_RESPONSES=true
CMI_TIMEOUT=30
CMI_OK_URL="${APP_URL}/credit-recharge/cmi/callback"
CMI_FAIL_URL="${APP_URL}/credit-recharge/cmi/callback"

# ==============================================
# Steve OCPP Backend
# Adjust host/credentials to the Steve server that this domain talks to.
# ==============================================
STEVE_BASE_URL=http://158.69.27.239:8180
STEVE_API_URL=http://158.69.27.239:8180/steve/api/v1
STEVE_API_USER=admin
STEVE_API_PASSWORD=1234
STEVE_API_PASS=1234
STEVE_USERNAME=admin
STEVE_PASSWORD=1234
STEVE_API_KEY=
STEVE_API_TOKEN=
STEVE_DEFAULT_ID_TAG=Open10Tag
STEVE_OCPP_BASE_URL=http://158.69.27.239:8180
STEVE_OCPP_SOAP_ENDPOINT=http://158.69.27.239:8180/steve/services/CentralSystemService
STEVE_OCPP_WEBSOCKET_ENDPOINT=ws://158.69.27.239:8180/steve/websocket/CentralSystemService/
