APP_NAME=EVON
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_INSTALLED=false

# Back-office (admin panel) routing & access control.
# ADMIN_PATH controls the URL prefix for /{ADMIN_PATH}/*. Set to a
# non-guessable value in production (e.g. "back-office-7f3a") so the
# staff area is not enumerable. Defaults to "admin".
# ADMIN_PANEL_PERMISSION is the Spatie permission that grants access.
# Users (admin, operator, integrator, partner, …) must hold this
# permission — directly or via a role — to enter the back-office.
ADMIN_PATH=admin
ADMIN_PANEL_PERMISSION=access-admin-panel

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evon
DB_USERNAME=evon
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log

SETUP_ENABLED=true
SETUP_DEVELOPER_PASSWORD_HASH=
SETUP_DEVELOPER_PASSWORD=
SETUP_BROWSER_TOKEN_HASH=
SETUP_BROWSER_TOKEN=
SETUP_ALLOW_LOCAL_CLAIM=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SMS_PROVIDER=infobip
SMS_TIMEOUT_SECONDS=10
RESERVATION_OTP_TTL_MINUTES=10
RESERVATION_OTP_MAX_ATTEMPTS=5
RESERVATION_OTP_SEND_MAX_ATTEMPTS=3
RESERVATION_OTP_SEND_DECAY_SECONDS=300

CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
CMI_OK_URL="${APP_URL}/credit-recharge/cmi/callback"
CMI_FAIL_URL="${APP_URL}/credit-recharge/cmi/callback"

# SteVe — single Java service, all listeners on the same HTTP port (default 8180).
# STEVE_API_URL is the REST base. SteVe 3.9.0's REST controllers map @RequestMapping("/api/v1"),
# so the URL is `/steve/api/v1`. `/steve/manager/*` is the HTML web UI — pointing the
# REST client there returns the sign-in page with HTTP 200, masking the real failure.
STEVE_BASE_URL=http://your-steve-host:8180
STEVE_API_URL=http://your-steve-host:8180/steve/api/v1
STEVE_API_USER=
STEVE_API_PASSWORD=

# SteVe auto-provision-on-create. TRUE (default) wraps the local DB write and the
# SteVe POST in a single atomic transaction — a SteVe failure rolls back the
# local charging point row. Set FALSE on environments where SteVe is intentionally
# unreachable (dev box, staging without SteVe, mid-migration deploys). With FALSE
# the row is persisted, `steve_provisioned_at` stays null, and
# `steve_connection_status.awaiting_sync=true` flags it for later retry via the
# admin `sync-steve` route.
STEVE_AUTO_PROVISION_ON_CREATE=true

# OCPP transports used by charge points to talk to SteVe (NOT the REST API).
STEVE_OCPP_SOAP_ENDPOINT=http://your-steve-host:8180/steve/services/CentralSystemService
STEVE_OCPP_WEBSOCKET_ENDPOINT=ws://your-steve-host:8180/steve/websocket/CentralSystemService/
STEVE_WEBSOCKET_URL=ws://your-steve-host:8180/steve/websocket/CentralSystemService/

# Infobip SMS — used for mandatory phone-number verification at registration
# and for legacy users before they can create reservations.
# Get the per-account base URL and API key from the Infobip portal.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://example.api.infobip.com
INFOBIP_SENDER=EVON
