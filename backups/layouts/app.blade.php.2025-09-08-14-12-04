    <script>
        function dashboardData() {
            return {
                // UI State
                darkMode: localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches),
                sidebarCollapsed: window.innerWidth < 1024,
                sidebarOpen: true,
                isLoading: false,
                searchQuery: '',
                notifications: [],

                init() {
                    // Initialize theme
                    this.$watch('darkMode', value => {
                        localStorage.setItem('theme', value ? 'dark' : 'light');
                        document.documentElement.classList.toggle('dark', value);
                    });

                    // Handle window resize
                    window.addEventListener('resize', () => {
                        if (window.innerWidth >= 1024) {
                            this.sidebarOpen = true;
                            this.sidebarCollapsed = false;
                        } else {
                            this.sidebarCollapsed = true;
                            this.sidebarOpen = false;
                        }
                    });

                    // Load notifications only if authenticated and not on the business profile creation page
                    @auth
                    if ('{{ request()->route()->getName() }}' !== 'business-profiles.create') {
                        this.loadNotifications();

                        // Refresh notifications every 30 seconds
                        setInterval(() => {
                            this.loadNotifications();
                        }, 30000);
                    }
                    @endauth
                },

                toggleTheme() {
                    this.darkMode = !this.darkMode;
                },

                toggleSidebar() {
                    if (window.innerWidth < 1024) {
                        this.sidebarOpen = !this.sidebarOpen;
                    } else {
                        this.sidebarCollapsed = !this.sidebarCollapsed;
                    }
                },

                async loadNotifications() {
                    try {
                        const response = await fetch('{{ route("admin.notifications.api.unread") }}', {
                            headers: {
                                'Accept': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                            },
                            credentials: 'include'
                        });
                        
                        if (!response.ok && response.status === 401) {
                            return; // Silently ignore 401 errors
                        }

                        if (response.ok) {
                            const data = await response.json();
                            if (data.success && data.notifications) {
                                this.notifications = data.notifications.map(n => ({
                                    id: n.id,
                                    title: n.type,
                                    message: n.message,
                                    time: this.formatTime(n.created_at)
                                }));
                            }
                        } else {
                            console.error('Error loading notifications:', response.statusText);
                        }
                    } catch (error) {
                        // Only log if it's not a network error or other unexpected issue
                        if (error.name !== 'AbortError' && error.message !== 'Failed to fetch') {
                            console.error('Notification fetch error:', error);
                        }
                    }
                },

                formatTime(timestamp) {
                    const date = new Date(timestamp);
                    const now = new Date();
                    const diff = now - date;
                    const minutes = Math.floor(diff / 60000);
                    const hours = Math.floor(diff / 3600000);
                    const days = Math.floor(diff / 86400000);

                    if (minutes < 1) return 'maintenant';
                    if (minutes < 60) return `il y a ${minutes} min`;
                    if (hours < 24) return `il y a ${hours}h`;
                    if (days < 7) return `il y a ${days}j`;
                    return date.toLocaleDateString('fr-FR');
                },

                performSearch() {
                    if (this.searchQuery.length > 2) {
                        console.log('Searching for:', this.searchQuery);
                        // Implement search logic here
                    }
                }
            }
        }
    </script>
